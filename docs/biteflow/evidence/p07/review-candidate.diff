+    </>:<AppText>{(metric==='weight'?[d.weight_source]:d.water_sources).filter(Boolean).map(s=>t(`tracking.sources.${s as 'manual'|'apple_health'|'health_connect'}`)).join(', ')||t('tracking.unknown')}</AppText>}
+   </View>)}
