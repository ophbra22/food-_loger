diff --git a/src/foodlogger/tracking.py b/src/foodlogger/tracking.py
new file mode 100644
index 0000000..1c106e9
--- /dev/null
+++ b/src/foodlogger/tracking.py
@@ -0,0 +1,240 @@
+"""Private measurements. Meal beverages never write to this independent journal."""
+
+import hashlib
+import json
+from datetime import UTC, datetime
+from decimal import Decimal
+from pathlib import Path
+from typing import Literal
+from uuid import uuid4
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+from pydantic import BaseModel, ConfigDict, Field, model_validator
+
+from foodlogger.foundation import lock_owner
+from foodlogger.schemas import JournalDate
+
+Kind = Literal["water", "weight"]
+
+
+class TrackingBody(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    value: float = Field(ge=0.1, le=15000, strict=True, allow_inf_nan=False)
+    occurred_at: datetime
+    local_date: JournalDate
+    timezone_id: str = Field(min_length=1, max_length=80)
+    source: Literal["manual", "apple_health", "health_connect"] = "manual"
+    external_id: str | None = Field(default=None, min_length=1, max_length=200)
+
+    @model_validator(mode="after")
+    def context(self):
+        try:
+            zone = ZoneInfo(self.timezone_id)
+        except (ZoneInfoNotFoundError, ValueError):
+            raise ValueError("Use an IANA timezone.") from None
+        if (
+            self.occurred_at.tzinfo is None
+            or self.occurred_at.utcoffset() != self.occurred_at.astimezone(zone).utcoffset()
+        ):
+            raise ValueError("Timestamp offset must match the timezone.")
+        if self.occurred_at.astimezone(zone).date() != self.local_date:
+            raise ValueError("Timestamp must belong to the local date.")
+        if (self.source == "manual") != (self.external_id is None):
+            raise ValueError(
+                "Imported records require an external identity; manual records cannot claim one."
+            )
+        return self
+
+
+class TrackingPatch(TrackingBody):
+    expected_version: int = Field(ge=1, strict=True)
+
+
+class TrackingConflict(ValueError):
+    pass
+
+
+def ensure_sqlite_tracking(database):
+    if not database.postgres:
+        with database.connect() as db:
+            for statement in (
+                (Path(__file__).parent / "data" / "tracking.sql").read_text().split(";")
+            ):
+                if statement.strip():
+                    db.execute(statement)
+
+
+def date_range(start, end):
+    if not 0 <= (end - start).days <= 30:
+        raise ValueError("Choose an inclusive range of 1–31 days.")
+
+
+def total(rows):
+    return float(sum((Decimal(str(r["value"])) for r in rows), Decimal(0)))
+
+
+class Tracking:
+    def __init__(self, database):
+        self.database = database
+
+    def available(self):
+        with self.database.connect() as db:
+            if self.database.postgres:
+                return bool(
+                    db.execute(
+                        "SELECT to_regclass('foodlogger.tracking_receipts') AS name"
+                    ).fetchone()["name"]
+                )
+            return bool(
+                db.execute("SELECT 1 FROM sqlite_master WHERE name='tracking_receipts'").fetchone()
+            )
+
+    @staticmethod
+    def public(row):
+        return {k: v for k, v in dict(row).items() if k not in ("user_id", "deleted")}
+
+    @staticmethod
+    def values(kind, body):
+        if kind == "weight" and not 1 <= body.value <= 500:
+            raise ValueError("Weight must be between 1 and 500 kg.")
+        values = body.model_dump(mode="json", exclude={"expected_version"})
+        # Fixed UTC representation makes text ordering chronological across offsets and DST.
+        values["occurred_at"] = body.occurred_at.astimezone(UTC).isoformat(timespec="microseconds")
+        return values
+
+    def create(self, owner, kind, body, key):
+        values = self.values(kind, body)
+        digest = hashlib.sha256(json.dumps([kind, values], sort_keys=True).encode()).hexdigest()
+        with self.database.connect() as db:
+            lock_owner(self.database, db, owner)
+            receipt = db.execute(
+                "SELECT * FROM tracking_receipts WHERE user_id=? AND request_key=?", (owner, key)
+            ).fetchone()
+            if receipt:
+                if receipt["request_hash"] != digest:
+                    raise TrackingConflict("Retry key belongs to a different request.")
+                row = self._get(db, owner, kind, receipt["entry_id"], include_deleted=True)
+                if row["deleted"]:
+                    raise TrackingConflict(
+                        "This entry was deleted. Start a new entry to log again."
+                    )
+                return self.public(row), False
+            existing = None
+            if body.external_id:
+                existing = db.execute(
+                    "SELECT * FROM tracking_entries WHERE user_id=? AND kind=? AND source=? "
+                    "AND external_id=?",
+                    (owner, kind, body.source, body.external_id),
+                ).fetchone()
+                if existing and (
+                    existing["deleted"] or any(existing[k] != v for k, v in values.items())
+                ):
+                    raise TrackingConflict(
+                        "External measurement already exists with different values or is deleted."
+                    )
+            now = datetime.now(UTC).isoformat()
+            row = (
+                dict(existing)
+                if existing
+                else dict(
+                    user_id=owner,
+                    id=uuid4().hex,
+                    kind=kind,
+                    **values,
+                    version=1,
+                    deleted=0,
+                    created_at=now,
+                    updated_at=now,
+                )
+            )
+            if not existing:
+                columns = list(row)
+                db.execute(
+                    f"INSERT INTO tracking_entries ({','.join(columns)}) "
+                    f"VALUES ({','.join('?' for _ in columns)})",
+                    tuple(row.values()),
+                )
+            db.execute(
+                "INSERT INTO tracking_receipts(user_id,request_key,request_hash,entry_id) "
+                "VALUES (?,?,?,?)",
+                (owner, key, digest, row["id"]),
+            )
+            return self.public(row), not bool(existing)
+
+    @staticmethod
+    def _get(db, owner, kind, identity, include_deleted=False):
+        row = db.execute(
+            "SELECT * FROM tracking_entries WHERE user_id=? AND kind=? AND id=?",
+            (owner, kind, identity),
+        ).fetchone()
+        if not row or (row["deleted"] and not include_deleted):
+            raise KeyError("Measurement not found.")
+        return row
+
+    def patch(self, owner, kind, identity, body):
+        values = self.values(kind, body)
+        with self.database.connect() as db:
+            lock_owner(self.database, db, owner)
+            row = self._get(db, owner, kind, identity)
+            if row["source"] != body.source or row["external_id"] != body.external_id:
+                raise TrackingConflict("Measurement provenance cannot be changed.")
+            if row["version"] != body.expected_version:
+                if row["version"] == body.expected_version + 1 and all(
+                    row[k] == v for k, v in values.items()
+                ):
+                    return self.public(row)
+                raise TrackingConflict("Measurement changed. Reload before editing.")
+            values.update(version=row["version"] + 1, updated_at=datetime.now(UTC).isoformat())
+            db.execute(
+                f"UPDATE tracking_entries SET {','.join(k + '=?' for k in values)} "
+                f"WHERE user_id=? AND id=?",
+                (*values.values(), owner, identity),
+            )
+            return self.public(self._get(db, owner, kind, identity))
+
+    def delete(self, owner, kind, identity, version):
+        with self.database.connect() as db:
+            lock_owner(self.database, db, owner)
+            row = self._get(db, owner, kind, identity, include_deleted=True)
+            if row["deleted"] and row["version"] == version + 1:
+                return
+            if row["deleted"] or row["version"] != version:
+                raise TrackingConflict("Measurement changed. Reload before deleting.")
+            db.execute(
+                "UPDATE tracking_entries SET deleted=1,version=version+1,updated_at=? "
+                "WHERE user_id=? AND id=?",
+                (datetime.now(UTC).isoformat(), owner, identity),
+            )
+
+    def list(self, owner, kind, start, end, limit=100, offset=0):
+        date_range(start, end)
+        with self.database.connect() as db:
+            lock_owner(self.database, db, owner)
+            params = (owner, kind, str(start), str(end))
+            where = "user_id=? AND kind=? AND deleted=0 AND local_date BETWEEN ? AND ?"
+            rows = db.execute(
+                "SELECT * FROM tracking_entries WHERE "
+                + where
+                + " ORDER BY occurred_at DESC,id DESC LIMIT ? OFFSET ?",
+                (*params, limit + 1, offset),
+            ).fetchall()
+            # Sum only scalar values, not every full row, even for an exported page.
+            values = db.execute(
+                "SELECT value FROM tracking_entries WHERE " + where, params
+            ).fetchall()
+            latest = db.execute(
+                "SELECT * FROM tracking_entries WHERE user_id=? AND kind=? AND deleted=0 "
+                "ORDER BY occurred_at DESC,id DESC LIMIT 2",
+                (owner, kind),
+            ).fetchall()
+            return dict(
+                items=[self.public(r) for r in rows[:limit]],
+                has_more=len(rows) > limit,
+                total=total(values) if kind == "water" else None,
+                latest=self.public(latest[0]) if latest else None,
+                previous=self.public(latest[1]) if len(latest) > 1 else None,
+                delta=float(Decimal(str(latest[0]["value"])) - Decimal(str(latest[1]["value"])))
+                if len(latest) > 1
+                else None,
+                **{"from": str(start), "to": str(end)},
+            )
diff --git a/src/foodlogger/trends.py b/src/foodlogger/trends.py
new file mode 100644
index 0000000..47698d9
--- /dev/null
+++ b/src/foodlogger/trends.py
@@ -0,0 +1,166 @@
+"""Bounded deterministic projections. Missing intake and weight never become zeroes."""
+
+from datetime import timedelta
+from decimal import Decimal
+
+from foodlogger.foundation import lock_owner
+from foodlogger.goals import effective_goal, progress
+from foodlogger.storage import Journal, summarize_entries
+from foodlogger.tracking import date_range, total
+
+NUTRIENTS = ("calories", "protein", "carbs", "fat")
+
+
+def average(values):
+    if not values or any(v is None for v in values):
+        return None
+    return float(sum((Decimal(str(v)) for v in values), Decimal(0)) / len(values))
+
+
+def period(start, end, meals, measurements, goals):
+    by_day = {}
+    tracked = {}
+    for entry in meals:
+        by_day.setdefault(entry["day"], []).append(entry)
+    for entry in measurements:
+        tracked.setdefault((entry["local_date"], entry["kind"]), []).append(entry)
+    days = []
+    for n in range((end - start).days + 1):
+        day = str(start + timedelta(days=n))
+        entries = by_day.get(day, [])
+        summary = summarize_entries(entries)
+        goal = effective_goal(goals, day)
+        weights = tracked.get((day, "weight"), [])
+        weight = max(weights, key=lambda r: (r["occurred_at"], r["id"]), default=None)
+        water = tracked.get((day, "water"), [])
+        days.append(
+            dict(
+                date=day,
+                logged=bool(entries),
+                logging_status="logged_incomplete" if entries else "unlogged",
+                **{k: summary[k] if entries else None for k in NUTRIENTS},
+                known_totals=summary["known_totals"] if entries else {k: None for k in NUTRIENTS},
+                partial=summary["partial"],
+                targets=goal,
+                calorie_status=progress(summary, goal)["calories"]["status"],
+                # Nutrient source claims remain in original snapshots, not upgraded by analytics.
+                nutrition_status="recorded_snapshot" if entries else "missing",
+                nutrition_sources=sorted(
+                    {
+                        e.get("details", {})
+                        .get("canonical_item", {})
+                        .get("source", {})
+                        .get("verified_status", "legacy_unknown")
+                        for e in entries
+                    }
+                ),
+                estimated=any(
+                    e.get("details", {})
+                    .get("canonical_item", {})
+                    .get("portion", {})
+                    .get("estimated", False)
+                    for e in entries
+                ),
+                weight=weight["value"] if weight else None,
+                weight_source=weight["source"] if weight else None,
+                water=total(water) if water else None,
+                water_sources=sorted({r["source"] for r in water}),
+            )
+        )
+    logged = [d for d in days if d["logged"]]
+    measured = [d for d in days if d["weight"] is not None]
+    watered = [d for d in days if d["water"] is not None]
+    eligible = [
+        d
+        for d in logged
+        if d["calories"] is not None and d["targets"] and d["targets"]["calorie_target"] is not None
+    ]
+    statistics = dict(
+        logged_days=len(logged),
+        unlogged_days=len(days) - len(logged),
+        measured_days=len(measured),
+        water_logged_days=len(watered),
+        average={
+            **{k: average([d[k] for d in logged]) for k in NUTRIENTS},
+            "weight": average([d["weight"] for d in measured]),
+            "water": average([d["water"] for d in watered]),
+        },
+        partial_days={k: sum(d["partial"][k] for d in logged) for k in NUTRIENTS},
+        calorie_in_range=sum(d["calorie_status"] == "in_range" for d in eligible),
+        calorie_eligible_days=len(eligible),
+        insufficient_data=len(logged) < len(days),
+        logging_complete=False,
+    )
+    return {"from": str(start), "to": str(end), "days": days, "statistics": statistics}
+
+
+class Trends:
+    def __init__(self, database):
+        self.database = database
+
+    def get(self, owner, start, end):
+        date_range(start, end)
+        try:
+            previous_end = start - timedelta(days=1)
+            previous_start = start - timedelta(days=(end - start).days + 1)
+        except OverflowError:
+            raise ValueError("The prior comparison falls outside supported dates.") from None
+        with self.database.connect() as db:
+            lock_owner(self.database, db, owner)
+            # One range read each, never one database query per chart point. Existing
+            # owner/day indexes.
+            meals = [
+                Journal._public(r)
+                for r in db.execute(
+                    "SELECT * FROM meals WHERE user_id=? AND day BETWEEN ? AND ?",
+                    (owner, str(previous_start), str(end)),
+                ).fetchall()
+            ]
+            measurements = [
+                dict(r)
+                for r in db.execute(
+                    "SELECT * FROM tracking_entries WHERE user_id=? "
+                    "AND kind IN ('water','weight') AND deleted=0 AND local_date BETWEEN ? AND ?",
+                    (owner, str(previous_start), str(end)),
+                ).fetchall()
+            ]
+            # One winning revision per date plus the effective baseline. No unbounded goal
+            # history read.
+            revisions = [
+                dict(r)
+                for r in db.execute(
+                    "SELECT g.* FROM user_nutrition_goal_revisions g WHERE g.user_id=? "
+                    "AND g.effective_local_date BETWEEN ? AND ? AND NOT EXISTS (SELECT 1 "
+                    "FROM user_nutrition_goal_revisions n WHERE n.user_id=g.user_id "
+                    "AND n.effective_local_date=g.effective_local_date AND n.version>g.version)",
+                    (owner, str(previous_start), str(end)),
+                ).fetchall()
+            ]
+            baseline = db.execute(
+                "SELECT * FROM user_nutrition_goal_revisions WHERE user_id=? "
+                "AND effective_local_date<? "
+                "ORDER BY effective_local_date DESC,version DESC LIMIT 1",
+                (owner, str(previous_start)),
+            ).fetchone()
+            if baseline:
+                revisions.append(dict(baseline))
+            for revision in revisions:
+                revision.pop("user_id", None)
+            goals = {"revisions": revisions}
+            current = period(start, end, meals, measurements, goals)
+            previous = period(previous_start, previous_end, meals, measurements, goals)
+            comparison = {}
+            for key, value in current["statistics"]["average"].items():
+                before = previous["statistics"]["average"][key]
+                comparison[key] = (
+                    float(Decimal(str(value)) - Decimal(str(before)))
+                    if value is not None and before is not None
+                    else None
+                )
+            return dict(
+                current=current,
+                previous=previous,
+                comparison=comparison,
+                comparison_basis="preceding_equal_length",
+                schema_version=1,
+            )
diff --git a/supabase/migrations/20261015112017_p07_tracking.sql b/supabase/migrations/20261015112017_p07_tracking.sql
new file mode 100644
index 0000000..aec1bde
--- /dev/null
+++ b/supabase/migrations/20261015112017_p07_tracking.sql
@@ -0,0 +1,54 @@
+-- Additive P07 private measurement storage; no existing rows rewritten.
+SET LOCAL search_path TO foodlogger, pg_catalog;
+CREATE TABLE IF NOT EXISTS tracking_entries (
+ user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+ id TEXT NOT NULL,
+ kind TEXT NOT NULL CHECK(kind IN ('water','weight')),
+ value DOUBLE PRECISION NOT NULL CHECK(value >= 0.1 AND value <= 15000 AND (kind != 'weight' OR value BETWEEN 1 AND 500)),
+ occurred_at TEXT NOT NULL,
+ local_date TEXT NOT NULL,
+ timezone_id TEXT NOT NULL,
+ source TEXT NOT NULL CHECK(source IN ('manual','apple_health','health_connect')),
+ external_id TEXT,
+ version INTEGER NOT NULL CHECK(version >= 1),
+ deleted INTEGER NOT NULL DEFAULT 0 CHECK(deleted IN (0,1)),
+ created_at TEXT NOT NULL,
+ updated_at TEXT NOT NULL,
+ PRIMARY KEY(user_id,id),
+ UNIQUE(user_id,kind,source,external_id),
+ CHECK((source='manual' AND external_id IS NULL) OR (source!='manual' AND external_id IS NOT NULL))
+);
+CREATE INDEX IF NOT EXISTS tracking_owner_day ON tracking_entries(user_id,kind,deleted,local_date,occurred_at,id);
+CREATE INDEX IF NOT EXISTS tracking_owner_time ON tracking_entries(user_id,kind,deleted,occurred_at,id);
+CREATE TABLE IF NOT EXISTS tracking_receipts (
+ user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+ request_key TEXT NOT NULL,
+ request_hash TEXT NOT NULL,
+ entry_id TEXT NOT NULL,
+ PRIMARY KEY(user_id,request_key),
+ FOREIGN KEY(user_id,entry_id) REFERENCES tracking_entries(user_id,id) ON DELETE CASCADE
+);
+
+REVOKE ALL ON foodlogger.tracking_entries FROM PUBLIC;
+DO $$ DECLARE role_name TEXT; BEGIN
+ FOREACH role_name IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
+  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname=role_name) THEN
+   EXECUTE format('REVOKE ALL ON foodlogger.tracking_entries FROM %I',role_name);
+  END IF;
+ END LOOP;
+END $$;
+GRANT SELECT,INSERT,UPDATE,DELETE ON foodlogger.tracking_entries TO foodlogger_app;
+ALTER TABLE foodlogger.tracking_entries ENABLE ROW LEVEL SECURITY;
+CREATE POLICY server_tracking_entries ON foodlogger.tracking_entries TO foodlogger_app USING (true) WITH CHECK (true);
+
+REVOKE ALL ON foodlogger.tracking_receipts FROM PUBLIC;
+DO $$ DECLARE role_name TEXT; BEGIN
+ FOREACH role_name IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
+  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname=role_name) THEN
+   EXECUTE format('REVOKE ALL ON foodlogger.tracking_receipts FROM %I',role_name);
+  END IF;
+ END LOOP;
+END $$;
+GRANT SELECT,INSERT,UPDATE,DELETE ON foodlogger.tracking_receipts TO foodlogger_app;
+ALTER TABLE foodlogger.tracking_receipts ENABLE ROW LEVEL SECURITY;
+CREATE POLICY server_tracking_receipts ON foodlogger.tracking_receipts TO foodlogger_app USING (true) WITH CHECK (true);
