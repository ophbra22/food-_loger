# Backend only. Never prefix these names with EXPO_PUBLIC_ or commit a real key.
GEMINI_API_KEY=
FOODLOGGER_VISION_PROVIDER=gemini
FOODLOGGER_VISION_MODEL=gemini-3.5-flash-lite
# Set to 1 only after verifying this key belongs to a project without billing.
# This flag records your verification; it cannot prevent later billing changes.
FOODLOGGER_GEMINI_FREE_TIER_CONFIRMED=0
