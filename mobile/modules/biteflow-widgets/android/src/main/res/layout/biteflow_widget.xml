<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/biteflow_widget_background">
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BiteFlow" android:textColor="#D5E2D5" android:textSize="12sp" android:maxLines="1"/>
 <TextView android:id="@+id/widget_energy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open BiteFlow" android:textColor="#F4F5E9" android:textSize="20sp" android:textStyle="bold" android:maxLines="2"/>
 <TextView android:id="@+id/widget_protein" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D5E2D5" android:textSize="13sp" android:maxLines="2"/>
 <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D5E2D5" android:textSize="12sp" android:maxLines="2"/>
 <TextView android:id="@+id/widget_water" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D5E2D5" android:textSize="13sp" android:maxLines="1"/>
 <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B7C7BA" android:textSize="11sp" android:maxLines="1"/>
</LinearLayout>
