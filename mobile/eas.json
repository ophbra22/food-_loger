{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE": "1" }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE": "1" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE": "1" }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "developmentClient": false,
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://foodlogger-yfn4.onrender.com",
        "EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6821706586",
        "appleTeamId": "283L7984CA"
      }
    }
  }
}
