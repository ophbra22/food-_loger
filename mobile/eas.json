{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE": "1" }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE": "1" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE": "1" }
    },
    "production": { "autoIncrement": true }
  }
}
