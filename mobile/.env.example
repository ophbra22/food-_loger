# Copy to .env and set the address of the FoodLogger backend.
# The value is compiled into the app, so rebuild (or restart `npm start`) after changing it.
# It is an address only. Never put passwords, database URLs or other secrets here.

# iOS Simulator on the same Mac as the backend:
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Android emulator (10.0.2.2 is the emulator's name for your computer):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# A physical phone on the same Wi-Fi: use your computer's LAN address, and start
# the backend with `foodlogger --host 0.0.0.0`. `localhost` on a phone is the phone itself.
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8000

# The deployed server (HTTPS):
# EXPO_PUBLIC_API_URL=https://your-foodlogger.onrender.com

EXPO_PUBLIC_API_URL=

# Set to 1 in test builds to allow changing the server address from Settings.
EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE=0

# Default off until native speech/privacy/device gates pass; requires a rebuilt binary.
EXPO_PUBLIC_VOICE_ENABLED=0

# P06 automatic label OCR requires server allowance and separate device/quality approval.
EXPO_PUBLIC_LABEL_OCR_ENABLED=0

# P09 stays off until push credentials, offline lifecycle and physical-device gates pass.
# Server decision/dispatch flags are separate; enabling this flag alone does not deliver.
EXPO_PUBLIC_REMINDERS_ENABLED=0

# P10 remains off pending native/device acceptance.
EXPO_PUBLIC_HEALTH_ENABLED=0

# P11 optional Android Health Connect; keep off until device/release gates pass.
EXPO_PUBLIC_HEALTH_CONNECT_ENABLED=0

# Native widgets stay off until device/privacy/signing gates are verified.
EXPO_PUBLIC_WIDGETS_ENABLED=0
