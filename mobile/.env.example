# Copy to .env and set the address of the FoodLogger backend.
# The value is compiled into the app, so rebuild (or restart `npm start`) after changing it.
# It is an address only. Never put passwords, database URLs or other secrets here.

# iOS Simulator on the same Mac as the backend:
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Android emulator (10.0.2.2 is the emulator's name for your computer):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# A physical phone on the same Wi-Fi: use your computer's LAN address, and start
# the backend with `foodlogger --host 0.0.0.0`. `localhost` on a phone is the phone itself.
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8000

# The deployed server (HTTPS):
# EXPO_PUBLIC_API_URL=https://your-foodlogger.onrender.com

EXPO_PUBLIC_API_URL=

# Set to 1 in test builds to allow changing the server address from Settings.
EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE=0
